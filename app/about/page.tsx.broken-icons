        <path d="M3 9h18L12 4 3 9Z" />
        <path d="M5 10v7M9 10v7M15 10v7M19 10v7M3 19h18" />
      </svg>
    );
  }

  if (type === "defence") {
    return (
      <svg viewBox="0 0 24 24" className={common} aria-hidden="true">
        <path d="M4 6h6v12H4zM14 6h6v12h-6z" />
        <path d="M10 12h4M2 19h20" />
      </svg>
    );
  }

  if (type === "bail") {
    return (
      <svg viewBox="0 0 24 24" className={common} aria-hidden="true">
        <path d="M12 4v16M5 7h14M7 7l-3 6h6L7 7ZM17 7l-3 6h6l-3-6Z" />
        <path d="M8 20h8" />
      </svg>
    );
  }

  if (type === "fir") {
    return (
      <svg viewBox="0 0 24 24" className={common} aria-hidden="true">
        <path d="M6 3h9l4 4v14H6z" />
        <path d="M15 3v5h4M9 12h6M9 16h6" />
      </svg>
    );
  }

  return (
    <svg viewBox="0 0 24 24" className={common} aria-hidden="true">
      <path d="M4 20h16M6 20V9M18 20V9M3 9h18M12 4l9 5H3l9-5Z" />
      <path d="M9 12v4M12 12v4M15 12v4" />
    </svg>
  );
}

