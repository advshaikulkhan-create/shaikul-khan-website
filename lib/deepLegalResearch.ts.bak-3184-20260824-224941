export type LegalAct = "BNS" | "BNSS" | "BSA";

export type ResearchSourceType =
  | "official-statute"
  | "user-supplied"
  | "case-law"
  | "research"
  | "procedural"
  | "evidence";

export interface LegacyMapping {
  act: string;
  section: string;
  source: "user-supplied" | "verified";
}

export interface DeepLegalResearch {
  act: LegalAct;

  section: string;

  title: string;

  chapter?: string;

  category?: string;

  /**
   * Exact statutory proposition / verified legal proposition.
   * This must not be filled with assumptions.
   */
  provision?: string;

  /**
   * Ingredients / essential elements of the offence or provision.
   */
  ingredients?: string[];

  /**
   * Punishment / consequence where applicable.
   */
  punishment?: string;

  /**
   * Procedural requirements.
   */
  proceduralRequirements?: string[];

  /**
   * Evidence requirements / evidentiary issues.
   */
  evidenceIssues?: string[];

  /**
   * Digital / electronic evidence issues.
   */
  digitalEvidenceIssues?: string[];

  /**
   * Defence-oriented issues.
   */
  defenceIssues?: string[];

  /**
   * Cross-examination themes.
   */
  crossExaminationIssues?: string[];

  /**
   * Bail-related considerations.
   */
  bailIssues?: string[];

  /**
   * Important case-law propositions.
   */
  caseLaw?: string[];

  /**
   * IPC / CrPC / Evidence Act legacy mapping.
   *
   * IMPORTANT:
   * User-supplied mappings remain separately identifiable.
   */
  legacyMapping?: LegacyMapping[];

  /**
   * Search keywords.
   */
  tags?: string[];

  /**
   * Research/source classification.
   */
  sources?: ResearchSourceType[];
}

