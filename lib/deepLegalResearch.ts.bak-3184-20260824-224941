export const deepLegalResearchData: DeepLegalResearch[] = [
  ...bnsDeepResearch,
  ...bnssDeepResearch,
  ...bsaDeepResearch
];

/* =========================================================
   SEARCH
   ========================================================= */

export function searchDeepLegalResearch(
  query: string
): DeepLegalResearch[] {
  const q = query.trim().toLowerCase();

  if (!q) {
    return deepLegalResearchData;
  }

  return deepLegalResearchData.filter((item) => {
    const searchable = [
      item.act,
      item.section,
      item.title,
      item.chapter,
      item.category,
      item.provision,
      ...(item.ingredients ?? []),
      item.punishment,
      ...(item.proceduralRequirements ?? []),
      ...(item.evidenceIssues ?? []),
      ...(item.digitalEvidenceIssues ?? []),
      ...(item.defenceIssues ?? []),
      ...(item.crossExaminationIssues ?? []),
      ...(item.bailIssues ?? []),
      ...(item.caseLaw ?? []),
      ...(item.tags ?? []),
      ...(item.legacyMapping ?? []).map(
        (mapping) =>
          `${mapping.act} ${mapping.section} ${mapping.source}`
      )
    ]
      .filter(Boolean)
      .join(" ")
      .toLowerCase();

    return searchable.includes(q);
  });
}
